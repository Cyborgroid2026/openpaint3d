<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>openpaint3d</AssemblyName>
    <RootNamespace>OpenPaint3D</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../engine/target/release/libopenpaint3d_engine.so" Link="libopenpaint3d_engine.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
